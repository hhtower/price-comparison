PORT=3000
# 生产环境默认值；本地开发使用 npm run dev。
# Production default; use npm run dev locally.
NODE_ENV=production
ADMIN_PASSWORD=change-me
# 站点公开 HTTPS 地址，用于页面、robots 和 sitemap。
# Public HTTPS origin for pages, robots and sitemap.
PUBLIC_SITE_URL=https://example.com

# 数据库与连接池配置，超时单位为毫秒。
# Database and pool settings; timeouts are in milliseconds.
DATABASE_URL=postgresql://user:password@localhost:5432/price_comparison
PG_SCHEMA=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
# 各角色连接数之和不得超过 PG_POOL_MAX。
# Role connection counts must sum to at most PG_POOL_MAX.
API_CONNECTIONS=2
CRAWLER_CONNECTIONS=1
AI_CONNECTIONS=2
STANDARDIZATION_CONNECTIONS=2
SLOW_QUERY_THRESHOLD_MS=250

# Redis 用于会话、缓存和分布式限流。
# Redis stores sessions, caches and distributed rate limits.
REDIS_URL=redis://localhost:6379
AUTH_SESSION_KEY_PREFIX=admin:
# 可选限流 Redis；未设置时复用 REDIS_URL，不要设为空值。
# Optional rate-limit Redis; omit to reuse REDIS_URL, never set empty.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# 仅在代理覆盖来源 IP 且 API 禁止直连时启用。
# Enable only when the proxy overwrites client IPs and blocks direct API access.
TRUST_PROXY=false

# 向服务发送访客公网 IP；留空禁用定位，仍保留 IP 记录。
# Sends visitor public IPs to the provider; blank disables geolocation, not IP recording.
ANALYTICS_GEO_URL=https://ipwho.is/{ip}?lang=zh-CN

# AI 总开关与增量开关；开发模式启用后也会执行排队任务。
# AI main and incremental switches; enabling them also runs queued jobs in dev mode.
AI_STANDARDIZATION_ENABLED=false
AI_INCREMENTAL_STANDARDIZATION_ENABLED=false
# 标签提取依赖 AI 总开关及模型配置；关闭后保留历史。
# Tag extraction requires AI and model configuration; disabling retains history.
AI_TAG_EXTRACTION_ENABLED=true
# 兼容 OpenAI 的模型服务配置。
# OpenAI-compatible model provider settings.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=180000
# 各 AI worker 和质量检测共享的模型并发数。
# Shared model concurrency for AI workers and quality probes.
AI_CONCURRENCY=2
# 单批去重输入上限；任务 batchSize 可进一步限制条数。
# Deduplicated batch input limits; job batchSize can further limit item count.
AI_BATCH_MAX_ITEMS=32
AI_BATCH_MAX_INPUT_BYTES=24576
AI_BATCH_MAX_INPUT_TOKENS=6000
# 完整请求预算，包含提示词、输入、候选和输出。
# Full request budgets include prompts, inputs, candidates and output.
AI_REQUEST_MAX_BYTES=131072
AI_REQUEST_MAX_CONTEXT_TOKENS=65536
# 输出预留含推理 token，必须小于上下文预算。
# Output reserve includes reasoning tokens and must be below the context budget.
AI_REQUEST_OUTPUT_RESERVE_TOKENS=32768
AI_MAX_OUTPUT_BYTES=1048576
AI_METRICS_TTL_SECONDS=172800
# AI 与检测工具共用 HTTP(S) 代理；留空直连，容器访问宿主用 host.docker.internal。
# Shared HTTP(S) proxy for AI and tools; blank means direct, use host.docker.internal for the Docker host.
AI_PROXY_URL=
# 参考价代理留空复用 AI_PROXY_URL；无代理时不采集，不调用模型。
# Reference-price proxy falls back to AI_PROXY_URL; collection requires a proxy and makes no model calls.
OFFICIAL_REFERENCE_PROXY_URL=
OFFICIAL_REFERENCE_ENABLED=true
# 参考价与汇率更新间隔（毫秒），并发范围 1–4。
# Reference-price and exchange-rate interval in milliseconds; concurrency: 1–4.
OFFICIAL_REFERENCE_INTERVAL_MS=7200000
OFFICIAL_REFERENCE_CONCURRENCY=2
# 思考模式：disabled、enabled 或 auto；留空不发送。
# Thinking mode: disabled, enabled or auto; blank omits the setting.
AI_THINKING=
# 推理强度：Sol 为 low/medium/high/xhigh/max，GLM 为 low/high/max；留空使用模型默认值。
# Reasoning effort: Sol accepts low/medium/high/xhigh/max, GLM accepts low/high/max; blank uses model defaults.
AI_REASONING_EFFORT=

# 质量工具单次流式检测限制；任务最多 10 分钟，密钥仅存于活动任务。
# Quality probe limits; tasks last up to 10 minutes and hold keys only while active.
QUALITY_AI_TIMEOUT_MS=30000
QUALITY_AI_MAX_OUTPUT_BYTES=65536

# 可选 IP 检测服务；{ip} 替换为公网 IP，信誉适配器替代内置信誉与 DNSBL 检测。
# Optional IP probes; {ip} becomes the public IP, a reputation adapter replaces built-in reputation and DNSBL checks.
# QUALITY_IP_IDENTITY_URL=https://ipwho.is/{ip}
# QUALITY_IP_REPUTATION_URL=https://your-adapter.example/reputation/{ip}
# QUALITY_IP_EGRESS_URL=https://api64.ipify.org?format=json
# QUALITY_IP_HEADERS_URL=https://httpbingo.org/headers
# QUALITY_IP_DNS_URL=https://cloudflare-dns.com/dns-query
# QUALITY_IP_DNSBL_ZONES=b.barracudacentral.org,bl.spamcop.net
# 探针为 JSON 数组，每类最多 5 项，使用 url 搭配 expectedText 或 expectStatus。
# Probes are JSON arrays of up to 5 entries per type, using url with expectedText or expectStatus.
# QUALITY_IP_AI_SERVICES=[{"url":"https://api.openai.com/v1/models","expectStatus":401}]
# 空数组使用内置 Netflix、TikTok 和 YouTube 检测。
# An empty array uses built-in Netflix, TikTok and YouTube probes.
# QUALITY_IP_STREAMING_SERVICES=[]

# 报价有效期（毫秒），默认 135 分钟；复用不延长验证时间。
# Quote validity in milliseconds, default 135 minutes; reuse does not extend verification.
CATALOG_QUOTE_TTL_MS=8100000

# 缓存版本更新最小间隔（毫秒），默认 30000；0 表示每次写入均更新。
# Minimum cache version bump interval in milliseconds, default 30000; 0 bumps on every write.
#CATALOG_VERSION_BUMP_MIN_INTERVAL_MS=30000

# 抓取成功后随机等待此区间（毫秒）；重启保留计划，失败使用退避。
# Random delay after successful crawls in milliseconds; schedules survive restarts, failures use backoff.
CRAWLER_MIN_INTERVAL_MS=600000
CRAWLER_TARGET_INTERVAL_MS=2700000
# 结算价在标价、起购数量变化或报价过期时重验；复用不续期。
# Reverify settlement prices on price or minimum-quantity changes or quote expiry; reuse does not renew validity.
CRAWLER_CONCURRENCY=3
CRAWLER_HOST_CONCURRENCY=2
# 域名最小请求间隔，格式 host:毫秒，逗号分隔；各采集任务通过 Redis 共享预算。
# Per-host spacing as comma-separated host:milliseconds; crawl tasks share budgets through Redis.
CRAWLER_HOST_MIN_INTERVAL_MS=wzyp.cn:500,www.16688.com.cn:1000,catfk.com:10000
# 采集代理列表，逗号分隔 HTTP/HTTPS/SOCKS5 地址；凭据仅填写在实际环境中。
# Comma-separated HTTP/HTTPS/SOCKS5 crawler proxies; supply credentials only in the actual environment.
# CRAWLER_PROXIES=http://<Authkey>:<Authpwd>@<tunnel-host>:<port>
# 留空直连；配置后仅使用代理，要求代理出站的部署必须填写。
# Blank means direct; configured lists allow proxies only, proxy-only deployments must set this.
CRAWLER_PROXIES=
# 自建站专用代理；留空使用 CRAWLER_PROXIES 第一项，平台店仍使用原列表。
# Self-hosted shop proxy; blank uses the first CRAWLER_PROXIES entry, platform shops keep the original list.
# CRAWLER_SELFHOSTED_PROXY_URL=http://host.docker.internal:7890
# 部署环境性能基准配置，按需启用。
# Optional performance benchmark settings for the deployment environment.
# STANDARDIZATION_BENCHMARK_CPU_LIMIT=
# STANDARDIZATION_BENCHMARK_MEMORY_LIMIT_BYTES=
# STANDARDIZATION_BENCHMARK_DATABASE_URL=
# STANDARDIZATION_BENCHMARK_REPORT_DIR=./output/benchmarks
# STANDARDIZATION_BENCHMARK_SEED=20260920
# STANDARDIZATION_BENCHMARK_RUNS=5

# Compose 默认使用内部数据库与 Redis；连接外部服务时设置以下覆盖项。
# Compose uses internal PostgreSQL and Redis by default; set these overrides for external services.
# COMPOSE_DATABASE_URL=postgresql://user:password@host:5432/price_comparison
# COMPOSE_REDIS_URL=redis://host:6379

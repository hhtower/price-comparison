{
  "name": "product-price-comparison",
  "version": "2026.10.2901",
  "type": "module",
  "scripts": {
    "start": "node dist/server/main.js",
    "start:dev": "tsx watch apps/api/src/main.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:ai-standardization": "concurrently -k -n ai,standardization \"tsx apps/api/src/workers/ai.worker.ts\" \"tsx apps/api/src/workers/standardization-entrypoint.ts\"",
    "build": "npm run build:shared && tsc -p apps/api/tsconfig.json && vite build --config apps/web/vite.config.js",
    "db:migrate": "tsx apps/api/scripts/migrate.ts",
    "worker:ai": "tsx apps/api/src/workers/ai.worker.ts",
    "worker:crawler": "tsx apps/api/src/workers/crawler.worker.ts",
    "worker:official-reference": "tsx apps/api/src/workers/official-reference.worker.ts",
    "worker:standardization": "tsx apps/api/src/workers/standardization-entrypoint.ts",
    "test": "npm run test:e2e && npm run test:web",
    "test:e2e": "cross-env CATALOG_VERSION_BUMP_MIN_INTERVAL_MS=0 node --import tsx --test --test-concurrency=1 \"apps/api/test/*.test.js\" \"apps/api/test/*.test.ts\" \"apps/api/test/*.spec.ts\" \"apps/api/test/*-spec.ts\"",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p packages/catalog/tsconfig.json --noEmit",
    "build:shared": "tsc -p packages/catalog/tsconfig.json",
    "postinstall": "npm run build:shared",
    "test:web": "cross-env NODE_ENV=test vitest run --config apps/web/vite.config.js --mode test"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
